# ╔══════════════════════════════════════════════════════════════╗
# ║       FRONTEND MUHIT O'ZGARUVCHILARI (.env.example)         ║
# ║  Bu fayl namuna — uni .env ga ko'chiring va to'ldiring      ║
# ║  cp .env.example .env                                       ║
# ╚══════════════════════════════════════════════════════════════╝

# ── Ilova identifikatori ──────────────────────────────────────
VITE_APP_NAME=NavaiTour
VITE_APP_DESCRIPTION=Navoiy viloyatidagi mehmonxonalarni qidiring

# ── Backend API + Socket.io manzili ──────────────────────────
# Socket.io avtomatik /api ni olib tashlaydi va shu manzilga ulanadi.
# Development (mahalliy server):
VITE_API_URL=http://localhost:5000/api
# Production (real server):
# VITE_API_URL=https://api.your-domain.com/api

# ── Xarita (Leaflet) ─────────────────────────────────────────
# Standart OpenStreetMap:
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# ── Google OAuth 2.0 ─────────────────────────────────────────
# https://console.cloud.google.com/ → APIs & Services → Credentials
# Backend GOOGLE_CLIENT_ID bilan bir xil qiymat bo'lishi kerak.
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here

# ── Rejim ─────────────────────────────────────────────────────
# development — konsolda [API ->] loglari ko'rinadi
# production  — loglar o'chirilgan, build optimallashtirilgan
NODE_ENV=development
