# ╔══════════════════════════════════════════════════════════════╗
# ║       FRONTEND MUHIT O'ZGARUVCHILARI (.env.example)         ║
# ║  Bu fayl namuna — uni .env ga ko'chiring va to'ldiring      ║
# ║  cp .env.example .env                                       ║
# ╚══════════════════════════════════════════════════════════════╝

# ── Ilova identifikatori ──────────────────────────────────────
# Loyiha nomini o'zgartirish uchun faqat shu qatorni tahrirlang.
# Bu qiymat avtomatik ravishda quyidagilarga qo'llaniladi:
#   - Browser tab sarlavhasi
#   - Sidebar brending
#   - Loading xabarlari
#   - SEO meta teglari
VITE_APP_NAME=NavaiTour
VITE_APP_DESCRIPTION=Navoiy viloyatidagi mehmonxonalarni qidiring

# ── Backend API manzili ───────────────────────────────────────
# Development (mahalliy server):
VITE_API_URL=http://localhost:5000/api

# Production (real server):
# VITE_API_URL=https://api.your-domain.com/api
# yoki IP manzil bilan:
# VITE_API_URL=http://123.45.67.89:5000/api

# ── Xarita (Leaflet — ixtiyoriy) ─────────────────────────────
# Standart OpenStreetMap ishlatiladi. Maxsus tile server uchun:
# VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# ── Rejim ─────────────────────────────────────────────────────
# development — konsolda [API ->] loglari ko'rinadi
# production  — loglar o'chirilgan, build optimallashtirilgan
NODE_ENV=development
